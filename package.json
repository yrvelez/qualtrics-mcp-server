{
  "name": "qualtrics-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for end-to-end Qualtrics survey programming and advanced API access",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "bin": {
    "qualtrics-mcp-server": "build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "docs",
    "examples"
  ],
  "scripts": {
    "start": "tsx --env-file=.env src/index.ts",
    "dev": "tsx --watch src/index.ts",
    "build": "tsgo -p tsconfig.build.json",
    "typecheck": "tsgo --noEmit",
    "typecheck:examples": "tsgo --ignoreConfig --noEmit --target es2022 --module node16 --moduleResolution node16 --strict --skipLibCheck examples/motivated-reasoning-study.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "example:motivated-reasoning": "npm run build && node --env-file=.env --import tsx examples/motivated-reasoning-study.ts",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@typescript/native-preview": "latest",
    "tsx": "^4.19.4"
  },
  "license": "MIT",
  "packageManager": "pnpm@9.15.9+sha512.68046141893c66fad01c079231128e9afb89ef87e2691d69e4d40eee228988295fd4682181bae55b58418c3a253bde65a505ec7c5f9403ece5cc3cd37dcf2531"
}
